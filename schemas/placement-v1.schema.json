{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dyluhn/R9V/schemas/placement-v1.schema.json",
  "title": "R9V model placement",
  "type": "object",
  "required": ["schema", "id", "model_package", "hardware", "policy"],
  "properties": {
    "schema": {"const": "r9v.placement.v1"},
    "id": {"type": "string", "minLength": 1},
    "model_package": {"type": "string", "minLength": 1},
    "hardware": {"type": "string", "minLength": 1},
    "artifact_path": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy": {"type": "object"},
    "scope": {"type": "string"}
  }
}
