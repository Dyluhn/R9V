# R9V Qwen3.8 Flash Next reference profile
# Two Radeon R9700 32 GiB GPUs, TP2, 128 GiB system RAM.

# Portable host contract. Lock BDF order after checking `amd-smi list`.
: "${R9V_VISIBLE_DEVICES:=0,1}"
: "${R9V_EXPECTED_GPU_BDFS:=}"
: "${R9V_EXPECTED_PCIE_LINKS:=}"
: "${R9V_MIN_PCIE_BANDWIDTH_GBPS:=0,0}"
: "${R9V_MIN_HOST_RAM_BYTES:=0}"
: "${R9V_MIN_HOST_AVAILABLE_BYTES:=0}"
: "${R9V_REFERENCE_HOST_RAM_BYTES:=128000000000}"
: "${R9V_REQUIRE_PLE_NONROTATIONAL:=1}"
: "${R9V_PLE_EXPECTED_BYTES:=28800138240}"
# sha256 of the derived IQ4_NL PLE table. Checked only with `doctor --hash-ple`.
: "${R9V_PLE_EXPECTED_SHA256:=dd55c28902f38cd88134b2a569c51282c5ffce30080487e1a645740115c56cc3}"
: "${R9V_DOCTOR_STRICT:=0}"
: "${R9V_PREFLIGHT:=1}"

: "${R9V_SERVED_MODEL_NAME:=qwen3.8-flash-next}"
: "${R9V_HOST_PORT:=8004}"
# The API has no authentication, so it is published on 127.0.0.1 only. To expose
# it, set another IPv4/IPv6 address (0.0.0.0: all interfaces) when running setup.
: "${R9V_HOST_BIND:=127.0.0.1}"
: "${R9V_TENSOR_PARALLEL_SIZE:=2}"
: "${R9V_MAX_MODEL_LEN:=131072}"
: "${R9V_MAX_NUM_SEQS:=1}"
: "${R9V_MAX_NUM_BATCHED_TOKENS:=1024}"
: "${R9V_KV_CACHE_MEMORY_BYTES:=2285670400}"
: "${R9V_CPU_OFFLOAD_GB:=112.5}"
: "${R9V_CPU_OFFLOAD_GB_BY_DEVICE:=112.5,112.5}"

: "${R9V_MTP_SPEC_TOKENS:=2}"
: "${R9V_MTP_DRAFT_TP_SIZE:=2}"
: "${R9V_MTP_LOCAL_ARGMAX:=1}"
: "${R9V_MTP_QUANTIZATION:=fp8}"

: "${R9V_TIERED_IQ_MOE_VARIANT:=reuse3v2}"
: "${R9V_TIERED_PREFILL_GROUP_SIZE:=16}"
: "${R9V_TIERED_EXPERT_CACHE_SLOTS:=16}"
: "${R9V_TIERED_EXPERT_CACHE_RANKS:=1}"
: "${R9V_TIERED_EXPERT_CACHE_POLICY:=lru}"
: "${R9V_TIERED_EXPERT_CACHE_ASYNC:=0}"
: "${R9V_MAX_EFFECTIVE_EXPERTS_PER_RANK:=329,385}"

: "${R9V_DENSE_Q8_ATTN_M3_VARIANT:=exact4-w8}"
: "${R9V_ENABLE_DENSE_Q8_ATTN_M3:=1}"
: "${R9V_ENABLE_DENSE_HC_DOWN_BF16_M3:=1}"
: "${R9V_ENABLE_FUSED_HC_UP_MIX:=1}"
: "${R9V_ENABLE_FUSED_MOE_SHARED_EPILOGUE:=1}"
: "${R9V_ENABLE_FUSED_GDN_MTP:=1}"
: "${R9V_ENABLE_RDNA4_QSA_STRIDED:=1}"

: "${R9V_PLE_RESIDENCY_MODE:=ssd}"
: "${R9V_PLE_PINNED_RESERVE_BYTES:=17179869184}"
: "${R9V_PLE_MMAP_READAHEAD:=1}"
: "${R9V_PLE_MMAP_TRIM_ROWS:=131072}"
: "${R9V_PLE_RSS_LOG_ROWS:=131072}"
: "${R9V_PLE_WORKER_TIMING:=0}"

: "${R9V_PROFILER_DIR:=}"
: "${R9V_PROFILER_WAIT_ITERATIONS:=0}"
: "${R9V_PROFILER_WARMUP_ITERATIONS:=1}"
: "${R9V_PROFILER_ACTIVE_ITERATIONS:=12}"
: "${R9V_PROFILER_MAX_ITERATIONS:=12}"

: "${R9V_ENABLE_AUTO_TOOL_CHOICE:=1}"
: "${R9V_TOOL_CALL_PARSER:=qwen3_coder}"
: "${R9V_REASONING_PARSER:=qwen3}"

: "${R9V_R4D:=0}"
: "${R9V_R4D_AR:=0}"
: "${R9V_R4D_GDN:=0}"
: "${R9V_R4D_AR_QUANT:=0}"

# Desired physical free VRAM on each TP rank, in GiB (1 GiB = 2^30 bytes).
# Doctor enforces this at the snapshot; it does not resize experts automatically.
: "${R9V_MIN_FREE_VRAM_GIB_BY_RANK:=3,3}"
# Optional generated placement outside the immutable model package.
: "${R9V_EXPERT_MANIFEST_PATH:=}"

# Reference performance target; slower complete paths warn rather than fail.
: "${R9V_REFERENCE_PCIE_BANDWIDTH_GBPS:=15,7}"
