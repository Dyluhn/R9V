# SPDX-License-Identifier: Apache-2.0
# Copy this file outside the checkout, edit it, then set R9V_CONFIG_FILE.
# The := form preserves an explicit value exported by the caller.

# HIP device indices in tensor-parallel rank order.
: "${R9V_VISIBLE_DEVICES:=0,1}"

# Lock the PCI addresses reported by `amd-smi list` after confirming rank order.
# Leave empty for discovery-only mode; the doctor will print the detected value.
: "${R9V_EXPECTED_GPU_BDFS:=}"

# Optional exact negotiated links in TP-rank order. Examples: Gen5x16,Gen4x4
# or 32x16,16x4. Leave empty for discovery; this verifies but cannot set PCIe.
: "${R9V_EXPECTED_PCIE_LINKS:=}"

# Minimum theoretical PCIe payload bandwidth for rank 0 and rank 1.
: "${R9V_MIN_PCIE_BANDWIDTH_GBPS:=15,7}"

# Optional hard RAM gates. Zero means report the value without rejecting it.
: "${R9V_MIN_HOST_RAM_BYTES:=0}"
: "${R9V_MIN_HOST_AVAILABLE_BYTES:=0}"

# The PLE table stays file-backed in SSD mode. Set this to your extracted file.
: "${R9V_PLE_PATH:=/fast-ssd/r9v/per_layer_token_embd.iq4_nl.bin}"
: "${R9V_PLE_RESIDENCY_MODE:=ssd}"
: "${R9V_REQUIRE_PLE_NONROTATIONAL:=1}"

# The published placement gives rank 1 a 16-slot LRU cache.
: "${R9V_TIERED_EXPERT_CACHE_RANKS:=1}"
: "${R9V_TIERED_EXPERT_CACHE_SLOTS:=16}"
: "${R9V_TIERED_EXPERT_CACHE_POLICY:=lru}"

# Static manifest count plus cache slots must remain within these VRAM budgets.
: "${R9V_MAX_EFFECTIVE_EXPERTS_PER_RANK:=329,385}"

# Enable for one diagnostic relaunch when investigating low decode throughput.
: "${R9V_PLE_WORKER_TIMING:=0}"
