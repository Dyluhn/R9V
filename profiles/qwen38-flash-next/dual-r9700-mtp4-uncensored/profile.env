# SPDX-License-Identifier: Apache-2.0
# Qwen3.8 Flash Next Uncensored IQ4_XS on the consolidated 1.3.0 runtime (mtp4-v3):
# pinned image 2dac17a2 plus SHA-256-pinned overlays, the full mutable expert
# cache, and CED (approximate long-prompt prefill) on by default.
: "${R9V_IMAGE:=sha256:2dac17a215fb5b0e3461e4c3e36a2981eec8ac3d6021e73183d247e819740c03}"
: "${R9V_PROFILE_ID:=qwen38-flash-next/uncensored-iq4-xs/dual-r9700-mtp4-128k}"
: "${R9V_MODEL_PACKAGE:=qwen38-flash-next-uncensored-iq4-xs-mtp-blockfp8-mmproj-f16}"
: "${R9V_TARGET_REL:=target/Qwen3.8-Flash-Next-Uncensored-UD-IQ4_XS-00001-of-00003.gguf}"
: "${R9V_TARGET_SHARD2_REL:=target/Qwen3.8-Flash-Next-Uncensored-UD-IQ4_XS-00002-of-00003.gguf}"
: "${R9V_TARGET_SHARD3_REL:=target/Qwen3.8-Flash-Next-Uncensored-UD-IQ4_XS-00003-of-00003.gguf}"
: "${R9V_MMPROJ_REL:=vision/mmproj-Qwen3.8-Flash-Next-Uncensored-F16.gguf}"
# Uncensored PLE payload hash (overrides the reference-target value from base).
: "${R9V_PLE_EXPECTED_SHA256:=34fa36f83de4216fe2aa78b5602aea1ba8007f959710c94bc4fbaff3e75fb9f0}"
# Available host RAM before launch: all 512 experts per layer pinned in host
# RAM as the mutable cache's backing (59,519,795,200 B) plus the 16 GiB pinned
# PLE reserve. Same floor as the deployed 1.3.0 service's start check.
: "${R9V_MIN_HOST_AVAILABLE_BYTES:=76699664384}"

# CED: layers 0-15 run exactly; the split-16 projector predicts layers 16-47 for
# all but the last ~2K prompt tokens. About 1.70x prefill on prompts of 12K+
# tokens for about x1.051 perplexity on prompts that depend on long context; the
# first answer after a CED prefill gets ~10% fewer MTP tokens per step. Decode is
# exact. `--ced off` in setup/start turns it off; a request opts out with
# "vllm_xargs": {"r9v_ced": false}.
: "${R9V_CED:=on}"
: "${R9V_CED_PROJECTOR_REL:=ced/ced-projector-split16.safetensors}"
: "${R9V_CED_PRECISION:=bf16}"
: "${R9V_CED_MIN_PROMPT:=8192}"
: "${R9V_CED_TAIL:=2048}"
: "${R9V_CED_DEFAULT:=on}"
# The loaded projector takes 1.76 GiB per GPU; with it the deployed reference
# service has about 1.7-1.8 GiB (rank 0) and 2.1-2.2 GiB (rank 1) free while
# idle, so the usual 3 GiB target cannot pass. Provisional target until the
# clean-host first-start qualification measures the workload minimum.
: "${R9V_MIN_FREE_VRAM_GIB_BY_RANK:=1.5,1.5}"

# Hybrid MTP prefix reuse: retain checkpoints at the resolved 1616-token
# scheduler block boundary (image 2dac17a2, TP2). Fixed KV budget unchanged.
: "${R9V_ENABLE_PREFIX_CACHING:=1}"
: "${R9V_PREFIX_CACHE_RETENTION_INTERVAL:=1616}"
: "${R9V_STAGE_DIAGNOSTICS:=1}"
: "${R9V_RETAINED_MTP4:=1}"
: "${R9V_STREAM_EXPERT_COMPACTION:=1}"
: "${R9V_MTP_SPEC_TOKENS:=4}"
# Prompt processing: 4096-token chunks on the gfx12 WMMA grouped MoE prefill
# kernel (group 32).
: "${R9V_MAX_NUM_BATCHED_TOKENS:=4096}"
: "${R9V_TIERED_PREFILL_GROUP_SIZE:=32}"
# The full mutable expert cache requires exactly this placement and cache
# configuration (hot 62/428, 160 slots on rank 0, LRU, synchronous fills).
: "${R9V_EXPERT_TP_SPLIT:=416,224}"
: "${R9V_TIERED_EXPERT_CACHE_SLOTS:=160}"
: "${R9V_TIERED_EXPERT_CACHE_RANKS:=0}"
: "${R9V_MAX_EFFECTIVE_EXPERTS_PER_RANK:=222,428}"
: "${R9V_KV_CACHE_MEMORY_BYTES:=2562215936}"
: "${R9V_CPU_OFFLOAD_GB_BY_DEVICE:=146.25,78.75}"
: "${R9V_DRAFT_W2_RANK_ROWS:=8192}"
: "${R9V_CACHE_FILL_BATCH:=1}"
: "${R9V_CACHE80:=1}"
: "${R9V_CACHE192:=1}"
: "${R9V_Q6K_HEAD_ROWS5:=1}"
: "${R9V_DENSE_ROWS45:=1}"
: "${R9V_DENSE_ROWS2:=0}"
: "${R9V_HC_ROWS45:=0}"
: "${R9V_HC_MMQ4:=1}"
: "${R9V_HC_MIX_MMQ4:=1}"
: "${R9V_HC_MIX_MMQ45:=1}"
: "${R9V_HC_SAFE_PADDING:=1}"
: "${R9V_ATTENTION_OUTPUT4:=1}"
: "${R9V_SHARED_SAFE_PADDING:=1}"
: "${R9V_NATIVE_CUSTOM_AR:=1}"
: "${R9V_NATIVE_ALIGN_IPC:=1}"
: "${R9V_Q8_MMVQ5_SHAPES:=[\"2560,3072\",\"640,2560\",\"2560,320\"]}"
r9v_profile_base=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../.." && pwd)
: "${R9V_RUNTIME_DESCRIPTOR:=$r9v_profile_base/runtimes/qwen38-flash-next-gfx1201-mtp4-v3/runtime.json}"
# Fixed placement (mtp4-full-mutable.json pins its SHA-256). No catalog, memory
# seed or placement plan: this profile never re-plans experts.
: "${R9V_EXPERT_MANIFEST_PATH:=$r9v_profile_base/packages/placements/qwen38-flash-next/uncensored-iq4-xs/dual-r9700/mtp4-warmstart-r1/manifest.json}"
source "$r9v_profile_base/profiles/qwen38-flash-next/dual-r9700/profile.env"
unset r9v_profile_base
